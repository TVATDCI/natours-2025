mixin reviewCard(review)
    .reviews__card
        .reviews__avatar
            img.reviews__avatar-img(src=`/img/users/${review.user.photo}`, alt=`${review.user.name}`)
            h6.reviews__user= review.user.name
        p.reviews__text= review.review
        .reviews__rating
            - for (let i = 1; i <= 5; i++)
                if i <= review.rating
                    svg.reviews__star.reviews__star--active
                        use(xlink:href='/img/icons.svg#icon-star')
                else
                    svg.reviews__star
                        use(xlink:href='/img/icons.svg#icon-star')


//- reviewCard Jonas's version
//- Uses each star in [1,2,3,4,5] → literally loops over an array of 5 numbers.
//- For each iteration:
//- Applies class reviews__star--active if review.rating >= star, otherwise reviews__star--inactive.
//- CSS handles the color/style of active vs inactive stars.

