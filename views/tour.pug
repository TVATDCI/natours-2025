extends base

block content
    section.section-header
        .header__hero
            .header__hero-overlay &nbsp;
            img.header__hero-img(src=`/img/tours/${tour.imageCover}`, alt=`${tour.name}`)

        .heading-box
            h1.heading-primary
                span= `${tour.name} Tour`
            p.heading-box__group
                span.heading-box__text= tour.duration + ' days'
                span.heading-box__text= tour.difficulty

    section.section-description
        .overview-box
            div
                h2.heading-secondary Quick facts
                ul
                    li
                        strong Duration:
                        |  #{tour.duration} days
                    li
                        strong Max group size:
                        |  #{tour.maxGroupSize}
                    li
                        strong Difficulty:
                        |  #{tour.difficulty}
                    li
                        strong Price:
                        |  $#{tour.price}