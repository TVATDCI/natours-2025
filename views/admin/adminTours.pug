extends ../base
include ../includes/adminSideNav
include ../includes/adminToursList.pug
include ../includes/adminUsersList.pug


block content
    main.main
        h2.heading-secondary--admin Manage Tours Dashboard
        .user-view
            +adminSideNav(section)
            .user-view__content
                if section === 'dashboard'
            
                else if section === 'tours'
                    +adminToursList(tours)
                else if section === 'users'
                    +adminUsersList(users)