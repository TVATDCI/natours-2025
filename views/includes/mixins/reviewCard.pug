mixin reviewCard(review)
  .reviews__card
    .reviews__avatar
      if review.user && review.user.photo && review.user.photo.startsWith('http')
        img.reviews__avatar-img(src=review.user.photo alt=`Photo of ${review.user.name}`)
      else if review.user && review.user.photo
        img.reviews__avatar-img(src=`/img/users/${review.user.photo}` alt=`Photo of ${review.user.name}`)
      else
        img.reviews__avatar-img(src='/img/users/default.jpg' alt='Default user')

      if review.user
        h6.reviews__user= review.user.name
      else
        h6.reviews__user Unknown
    p.reviews__text= review.review
    .reviews__rating
      - for (let i = 1; i <= 5; i++)
        if i <= review.rating
          svg.reviews__star.reviews__star--active
            use(xlink:href='/img/icons.svg#icon-star')
        else
          svg.reviews__star
            use(xlink:href='/img/icons.svg#icon-star')