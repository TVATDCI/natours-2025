mixin adminReviewCard(review)
  .reviews__card
    .reviews__avatar
      if review.user && review.user.photo && review.user.photo.startsWith('http')
        img.reviews__avatar-img(src=review.user.photo alt=`Photo of ${review.user.name}`)
      else if review.user && review.user.photo
        img.reviews__avatar-img(src=`/img/users/${review.user.photo}` alt=`Photo of ${review.user.name}`)
      else
        img.reviews__avatar-img(src='/img/users/default.jpg' alt='Default user')

      if review.user
        h6.reviews__user= review.user.name
      else
        h6.reviews__user Unknown

    .admin-review__desc
      p
        span.admin-review__meta Tour:
        span.admin-review__status #{review.tour ? review.tour.name : 'N/A'}
      p
        span.admin-review__meta Rating: #{review.rating}
      p
        span.admin-review__meta Created: #{new Date(review.createdAt).toLocaleDateString()}

    p.admin-reviews__text
      - const maxLen = 150
      = review.review && review.review.length > maxLen ? review.review.substring(0, maxLen) + '…' : review.review

    .reviews__rating
      - for (let i = 1; i <= 5; i++)
        if i <= review.rating
          svg.reviews__star.reviews__star--active
            use(xlink:href='/img/icons.svg#icon-star')
        else
          svg.reviews__star
            use(xlink:href='/img/icons.svg#icon-star')

    .admin-review__actions
      a.btn.btn--small.btn--green(href=`/admin/reviews/${review._id}`) Edit / Delete / Reply / TBC