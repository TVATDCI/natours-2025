mixin adminSideNav(section)
  nav.user-view__menu
    ul.side-nav
      li(class=`${section === 'settings' ? 'side-nav--active' : ''}`)
        a(href='/me')
          svg
            use(xlink:href='/img/icons.svg#icon-settings')
          | Settings
      li
        a(href='/my-tours')
          svg
            use(xlink:href='/img/icons.svg#icon-briefcase')
          | My bookings

    .admin-nav
      h5.admin-nav__heading Admin
      ul.side-nav
        li(class=`${section === 'tours' ? 'side-nav--active' : ''}`)
          a(href='/admin/tours')
            svg
              use(xlink:href='/img/icons.svg#icon-map')
            | Manage tours
        li(class=`${section === 'users' ? 'side-nav--active' : ''}`)
          a(href='/admin/users')
            svg
              use(xlink:href='/img/icons.svg#icon-users')
            | Manage users
        li(class=`${section === 'reviews' ? 'side-nav--active' : ''}`)
          a(href='/admin/reviews')
            svg
              use(xlink:href='/img/icons.svg#icon-star')
            | Manage reviews
        li(class=`${section === 'bookings' ? 'side-nav--active' : ''}`)
          a(href='/admin/bookings')
            svg
              use(xlink:href='/img/icons.svg#icon-briefcase')
            | Manage bookings
