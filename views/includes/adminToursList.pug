//- views/includes/adminToursList.pug
mixin adminToursList(tours)
  .card-container
    if tours && tours.length
      each tour in tours
        .card
          .card__header
            .card__picture
              .card__picture-overlay &nbsp;
              //- Support cloud URLs or local filenames
              if tour.imageCover && tour.imageCover.startsWith('http')
                img.card__picture-img(src=tour.imageCover, alt=tour.name)
              else if tour.imageCover
                img.card__picture-img(src=`/img/tours/${tour.imageCover}`, alt=tour.name)
              else
                img.card__picture-img(src='/img/tours/default.jpg', alt=tour.name)

            h3.heading-tertiary
              span= tour.name

          .card__details
            h4.card__sub-heading= `${tour.difficulty} ${tour.duration}-day tour`
            p.card__text= tour.summary
            .card__data
              svg.card__icon
                use(xlink:href='/img/icons.svg#icon-map-pin')
              span= tour.startLocation ? tour.startLocation.description : 'Unknown start'
            .card__data
              svg.card__icon
                use(xlink:href='/img/icons.svg#icon-calendar')
              - var startDate = (tour.startDates && tour.startDates.length) ? tour.startDates[0] : null;
              if startDate
                span= new Date(startDate).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
              else
                span TBA
            .card__data
              svg.card__icon
                use(xlink:href='/img/icons.svg#icon-flag')
              span= `${(tour.locations && tour.locations.length) || 0} stops`
            .card__data
              svg.card__icon
                use(xlink:href='/img/icons.svg#icon-user')
              span= `${tour.maxGroupSize || '—'} people`

          .card__footer
            p
              span.card__footer-value= `$ ${tour.price}`
              | 
              span.card__footer-text per person
            p.card__ratings
              span.card__footer-value= tour.ratingsAverage || '—'
              | 
              span.card__footer-text= `rating (${tour.ratingsQuantity || 0})`

            //- Admin-specific actions (Edit goes to your admin detail route)
            .admin-card__actions
              // route: /admin/tours/:id -> viewController.getAdminTourDetail
              a.btn.btn--green.btn--small(href=`/admin/tours/${tour._id}`) Edit
              a.btn.btn--transparent_red.btn--small(href=`/admin/tours/${tour._id}/delete`) Delete
    else
      p.admin-tours__empty No tours found.