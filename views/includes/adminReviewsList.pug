include ./mixins/adminReviewCard.pug
include ./mixins/pagination.pug

mixin adminReviewsList(reviews, currentPage, totalPages)

    if reviews && reviews.length
      +pagination(currentPage, totalPages, '/admin/reviews')
      .card-container
        each review in reviews
          +adminReviewCard(review)

      //- Pagination controls
      +pagination(currentPage, totalPages, '/admin/reviews')
    else
      p.admin-reviews__empty No reviews found.

