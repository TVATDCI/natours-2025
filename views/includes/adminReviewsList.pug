mixin adminReviewsList(reviews, currentPage, totalPages)
  .user-view__form-container
    h2.heading-secondary.ma-bt-md Manage Reviews
    if reviews && reviews.length
      ul.admin-reviews__list
        each rev in reviews
          li.admin-reviews__item
            span.admin-reviews__meta
              | Tour: #{rev.tour ? rev.tour.name : 'N/A'}
            span.admin-reviews__meta
              | User: #{rev.user ? rev.user.name : 'Anonymous'}
            span.admin-reviews__meta
              | Rating: #{rev.rating}
            p.admin-reviews__text= rev.review

      //- Pagination controls
      if totalPages > 1
        .pagination
          if currentPage > 1
            a.pagination__link(href=`?page=${currentPage - 1}`) Prev
          span.pagination__info Page #{currentPage} of #{totalPages}
          if currentPage < totalPages
            a.pagination__link(href=`?page=${currentPage + 1}`) Next
    else
      p.admin-reviews__empty No reviews found.
