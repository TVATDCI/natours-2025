//- views/includes/adminReviewsList.pug
mixin adminReviewsList(reviews, currentPage, totalPages)

    if reviews && reviews.length
      //- Container for cards
      .card-container
        each review in reviews
          +reviewCard(review)

      //- Pagination controls
      if totalPages > 1
        .pagination
          if currentPage > 1
            a.pagination__link(href=`?page=${currentPage - 1}`) Prev
          span.pagination__info Page #{currentPage} of #{totalPages}
          if currentPage < totalPages
            a.pagination__link(href=`?page=${currentPage + 1}`) Next
    else
      p.admin-reviews__empty No reviews found.

