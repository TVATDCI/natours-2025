mixin adminUsersList(users)
  .user-view__form-container
    h2.heading-secondary.ma-bt-md Users List

    if users && users.length
      //- Group users by role
      each roleGroup in ['admin', 'lead-guide', 'guide', 'user']
        - const groupUsers = users.filter(u => u.role === roleGroup);
        if groupUsers.length
          h3.heading-tertiary.ma-bt-sm= roleGroup.charAt(0).toUpperCase() + roleGroup.slice(1) + 's'
          ul.admin-user__list
            each usr in groupUsers
              li.admin-user__item
                .admin-user__info
                  a.admin-user__link(href=`/admin/users/${usr._id}`)= usr.name
                  span.admin-user__meta= usr.email

                .admin-user__actions
                  a.btn.btn--small.btn--transparent_green(href=`/admin/users/${usr._id}`) Edit
        else
          //- optional: skip empty roles
          p.admin-users__empty No #{roleGroup}s found
    else
      p.admin-user__empty No users found.
