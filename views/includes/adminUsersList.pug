mixin adminUsersList(users)
  .user-view__form-container
    h2.heading-secondary.ma-bt-md Manage Users
    if users && users.length
      ul.admin-users__list
        each usr in users
          li.admin-users__item
            //- Avoid name collision with `user` (logged-in)
            a.admin-users__link(href=`/admin/users/${usr._id}`)= usr.name
            span.admin-users__meta= usr.email
    else
      p.admin-users__empty No users found.
