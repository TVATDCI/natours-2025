mixin adminUsersList(users)
  .user-view__form-container
    h2.heading-secondary.ma-bt-md Manage Users

    if users && users.length
      // Group users by role
      each roleGroup in ['admin', 'lead-guide', 'guide', 'user']
        - const groupUsers = users.filter(u => u.role === roleGroup);
        if groupUsers.length
          h3.heading-tertiary.ma-bt-sm= roleGroup.charAt(0).toUpperCase() + roleGroup.slice(1) + 's'
          ul.admin-users__list
            each usr in groupUsers
              li.admin-users__item
                .admin-users__info
                  a.admin-users__link(href=`/admin/users/${usr._id}`)= usr.name
                  span.admin-users__meta= usr.email

                .admin-users__actions
                  a.btn.btn--small.btn--green(href=`/admin/users/${usr._id}`) Edit
        else
          //- optional: skip empty roles
          //- p.admin-users__empty No #{roleGroup}s found
    else
      p.admin-users__empty No users found.
