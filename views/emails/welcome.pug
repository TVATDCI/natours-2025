extends baseEmail

block content
    p Hi #{firstName},
    p Welcome to Natours - 2025, we're glad to have you 🎉
    p We're all a big family here, so make sure to upload your user photo so we get to know you a bit better!
    table.btn.btn-primary(role='presentation' border='0' cellpadding='0' cellspacing='0')
        tbody
            tr
                td(align='left')
                    table(role='presentation' border='0' cellpadding='0' cellspacing='0')
                        tbody
                            tr
                                td
                                    a(href=`${url}` target='_blank') Upload user photo
    p If you need any help with booking your next tour, please don't hesitate to contact me!
    p TVATDCI, CEO

    // The base template for emails.js is in baseEmail.pug
    // What happening here is just the block content which replaces `block content` 
    // Then it is extended here for easier editing - maintenance!
